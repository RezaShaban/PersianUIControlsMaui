<?xml version="1.0" encoding="UTF-8"?>
<controls:PersianInputBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiPersianToolkit.Controls.EntryView"
             xmlns:controls="clr-namespace:MauiPersianToolkit.Controls" x:DataType="controls:EntryView"
             x:Name="entryView">
    <!-- Column 0 = icon (right under RTL), column 1 = text, column 2 = append -->
    <Grid HorizontalOptions="Fill" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,52" Padding="0,10" ColumnSpacing="0">

        <Label Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
               Text="{Binding PlaceHolder,Source={x:Reference entryView}}"
               Padding="0" HorizontalOptions="Start" VerticalTextAlignment="Center"
               x:Name="lblPlaceholder" InputTransparent="True" VerticalOptions="Center"
               TextColor="{Binding PlaceHolderColor,Source={x:Reference entryView},Mode=OneWay}"
               FontFamily="IranianSans" FontAttributes="Bold"/>

        <Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                   x:Name="outline"
                   Stroke="{AppThemeBinding Light={StaticResource PdtOutlineLight}, Dark={StaticResource PdtOutlineDark}}"
                   StrokeThickness="1"
                   Fill="{AppThemeBinding Light={StaticResource PdtInputFillLight}, Dark={StaticResource PdtInputFillDark}}"
                   RadiusX="5" RadiusY="5" InputTransparent="True"/>

        <!-- Optical TranslationY: IranianSans glyph box sits high in the em square. -->
        <Entry Grid.Row="1" Grid.Column="1"
               HorizontalOptions="Fill" VerticalOptions="Fill"
               VerticalTextAlignment="Center"
               Text="{Binding Text,Source={x:Reference entryView}}"
               Margin="8,0" FontSize="Small" x:Name="entry"
               TranslationY="2"
               BackgroundColor="Transparent"
               ReturnType="{Binding ReturnType,Source={x:Reference entryView}}"
               FlowDirection="{Binding EntryFlowDirection,Source={x:Reference entryView}}"
               ReturnCommand="{Binding ReturnCommand,Source={x:Reference entryView}}"
               Keyboard="{Binding Keyboard,Source={x:Reference entryView}}"
               TextColor="{Binding TextColor,Source={x:Reference entryView}}"
               IsPassword="{Binding IsPassword,Source={x:Reference entryView}}"
               HorizontalTextAlignment="{Binding HorizontalTextAlignment,Source={x:Reference entryView}}"
               Placeholder="{Binding PlaceHolder,Source={x:Reference entryView}}"
               FontFamily="IranianSans" TextChanged="entry_TextChanged"/>

        <!-- Icon drawn last so it sits above the Border fill (right side under RTL). -->
        <Label Grid.Column="0" Grid.Row="1"
               Text="{Binding Icon,Source={x:Reference entryView}}"
               FontSize="18" WidthRequest="48" VerticalTextAlignment="Center"
               HorizontalOptions="Center" VerticalOptions="Fill"
               TextColor="{Binding PlaceHolderColor,Source={x:Reference entryView},Mode=OneWay}"
               HorizontalTextAlignment="Center" FontFamily="FontAwesome" InputTransparent="True">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding Icon,Source={x:Reference entryView}}" Value="">
                    <Setter Property="IsVisible" Value="False"/>
                    <Setter Property="WidthRequest" Value="0"/>
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <Label Grid.Row="1" Grid.Column="2"
               Text="{Binding AppendText,Source={x:Reference entryView}}"
               VerticalOptions="Center" FlowDirection="LeftToRight" HorizontalOptions="End"
               Padding="6,0,8,0" x:Name="append" InputTransparent="True"/>

        <Label Text="{Binding ErrorMessage,Source={x:Reference entryView}}"
               Grid.Column="0" Grid.ColumnSpan="3"
               HorizontalOptions="End" VerticalTextAlignment="Center" x:Name="lblMessage" FontSize="12"
               Grid.Row="1" InputTransparent="True" VerticalOptions="End" Margin="0,0,0,-18"
               IsVisible="{Binding IsValid,Source={x:Reference entryView}}"
               TextColor="{Binding ErrorMessageColor,Source={x:Reference entryView}}"/>
    </Grid>
</controls:PersianInputBase>
