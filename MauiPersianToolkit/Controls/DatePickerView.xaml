<?xml version="1.0" encoding="UTF-8"?>
<mpt:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
               xmlns:mpt="http://schemas.mauipersiantoolkit.com/2026/toolkit"
               xmlns:vm="clr-namespace:MauiPersianToolkit.ViewModels"
               xmlns:models="clr-namespace:MauiPersianToolkit.Models"
               x:Class="MauiPersianToolkit.Controls.DatePickerView" x:DataType="vm:DatePickerViewModel"
               BackgroundColor="Transparent" HorizontalOptions="Fill" VerticalOptions="Center" x:Name="page">
    <mpt:Popup.Resources>
        <!-- Static platform values — evaluated once at startup, not per item -->
        <OnPlatform x:Key="DayButtonSize" x:TypeArguments="x:Double" Default="36">
            <On Platform="Android" Value="36" />
            <On Platform="iOS" Value="36" />
            <On Platform="WinUI" Value="36" />
        </OnPlatform>
        <OnPlatform x:Key="DayButtonPadding" x:TypeArguments="Thickness" Default="5,3">
            <On Platform="Android" Value="5,3" />
            <On Platform="iOS" Value="5,3" />
            <On Platform="WinUI" Value="5,3" />
        </OnPlatform>
        <OnPlatform x:Key="BorderWidth" x:TypeArguments="x:Double" Default="300">
            <On Platform="Android" Value="300" />
            <On Platform="iOS" Value="300" />
            <On Platform="WinUI" Value="300" />
        </OnPlatform>
        <OnPlatform x:Key="BorderHeight" x:TypeArguments="x:Double" Default="486">
            <On Platform="WinUI" Value="450" />
        </OnPlatform>
    </mpt:Popup.Resources>

    <!-- x:Name on root gives DataTemplates a cheap x:Reference instead of AncestorType traversal -->
    <Border x:Name="RootBorder" Background="{AppThemeBinding Light={StaticResource PdtSurfaceLight}, Dark={StaticResource PdtSurfaceDark}}" HorizontalOptions="Center" FlowDirection="RightToLeft"
            WidthRequest="{StaticResource BorderWidth}"
            HeightRequest="{StaticResource BorderHeight}">
        <Border.StrokeShape>
            <RoundRectangle Fill="Transparent" CornerRadius="7" StrokeThickness="1"
                            StrokeLineJoin="Round" Stroke="Transparent"/>
        </Border.StrokeShape>

        <Grid HorizontalOptions="Fill" Padding="15"
              RowDefinitions="48,48,38,38,38,38,38,38,Auto,Auto,Auto"
              RowSpacing="0" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <OnPlatform Android="38,38,38,38,38,38,38" iOS="38,38,38,38,38,38,38" WinUI="45,45,45,45,45,45,45"/>
            </Grid.ColumnDefinitions>

            <!-- ── Header row: month/year navigation ── -->
            <Grid Grid.Row="0" Grid.Column="0" ColumnSpacing="0" RowDefinitions="36" VerticalOptions="Start">
                <Grid.Behaviors>
                    <mpt:PlatformColumnSpanBehavior Android="7" iOS="7" WinUI="6"/>
                </Grid.Behaviors>
                <Grid.ColumnDefinitions>
                    <OnPlatform Android="42,42,55*,45*,42,42" iOS="42,42,55*,45*,42,42" WinUI="40,40,60*,40*,40,40"/>
                </Grid.ColumnDefinitions>

                <Button Text="&#xf054;" Margin="0" Command="{Binding PrevMonthCommand}"
                        TextColor="{AppThemeBinding Light={StaticResource PdtOnSurfaceLight}, Dark={StaticResource PdtOnSurfaceDark}}" Padding="5,0" Grid.Column="0" Grid.Row="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PdtDayButtonLight}, Dark={StaticResource PdtDayButtonDark}}" FontFamily="FontAwesome" BorderWidth="1"
                        BorderColor="{AppThemeBinding Light={StaticResource PdtOutlineLight}, Dark={StaticResource PdtOutlineDark}}" FontSize="Micro" HeightRequest="28" WidthRequest="28"
                        VerticalOptions="Center" HorizontalOptions="Start" CornerRadius="7"/>

                <!-- Month selector button -->
                <Button HorizontalOptions="Fill" Text="{Binding CurrentMonth}" FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource PdtOnSurfaceLight}, Dark={StaticResource PdtOnSurfaceDark}}" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PdtDayButtonLight}, Dark={StaticResource PdtDayButtonDark}}" FontFamily="IranianSans" FontAutoScalingEnabled="True"
                        Command="{Binding SwitchModeCommand}" CommandParameter="0">
                    <Button.Padding>
                        <OnPlatform Android="7" iOS="10,7" WinUI="5,7"/>
                    </Button.Padding>
                    <Button.ContentLayout>
                        <OnPlatform Android="Left,15" iOS="Left,15" WinUI="Left,10"/>
                    </Button.ContentLayout>
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xf078;" FontFamily="FontAwesome" Color="{AppThemeBinding Light={StaticResource PdtOnSurfaceLight}, Dark={StaticResource PdtOnSurfaceDark}}" Size="14"/>
                    </Button.ImageSource>
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectDateMode}" Value="0">
                            <Setter Property="IsVisible" Value="False"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Year selector button -->
                <Button HorizontalOptions="Fill" Text="{Binding CurrentYear}" TextColor="{AppThemeBinding Light={StaticResource PdtOnSurfaceLight}, Dark={StaticResource PdtOnSurfaceDark}}"
                        Padding="10,7" Grid.Column="3" Grid.Row="0" BackgroundColor="{AppThemeBinding Light={StaticResource PdtDayButtonLight}, Dark={StaticResource PdtDayButtonDark}}"
                        FontFamily="IranianSans" FontAutoScalingEnabled="True" Grid.ColumnSpan="2"
                        Command="{Binding SwitchModeCommand}" CommandParameter="2" ContentLayout="Left,20">
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xf078;" FontFamily="FontAwesome" Color="{AppThemeBinding Light={StaticResource PdtOnSurfaceLight}, Dark={StaticResource PdtOnSurfaceDark}}" Size="14"/>
                    </Button.ImageSource>
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectDateMode}" Value="2">
                            <Setter Property="IsVisible" Value="False"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Text="&#xf053;" Margin="0" Command="{Binding NextMonthCommand}"
                        TextColor="{AppThemeBinding Light={StaticResource PdtOnSurfaceLight}, Dark={StaticResource PdtOnSurfaceDark}}" Padding="5,0" Grid.Column="5" Grid.Row="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PdtDayButtonLight}, Dark={StaticResource PdtDayButtonDark}}" FontFamily="FontAwesome" BorderWidth="1"
                        BorderColor="{AppThemeBinding Light={StaticResource PdtOutlineLight}, Dark={StaticResource PdtOutlineDark}}" FontSize="Micro" HeightRequest="28" WidthRequest="28"
                        VerticalOptions="Center" HorizontalOptions="End" CornerRadius="7"/>
            </Grid>

            <!-- ── Month picker (mode 0) — CollectionView replaces FlexLayout ── -->
            <CollectionView Grid.Column="0" Grid.Row="1" Grid.RowSpan="7" IsVisible="False" ItemsSource="{Binding PersianMonths}"
                            ItemSizingStrategy="MeasureFirstItem">
                <CollectionView.Behaviors>
                    <mpt:PlatformColumnSpanBehavior Android="7" iOS="7" WinUI="6"/>
                </CollectionView.Behaviors>
                <CollectionView.Triggers>
                    <DataTrigger TargetType="CollectionView" Binding="{Binding SelectDateMode}" Value="0">
                        <Setter Property="IsVisible" Value="True"/>
                    </DataTrigger>
                </CollectionView.Triggers>
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Span="3" Orientation="Vertical" HorizontalItemSpacing="0"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PuiTuple">
                        <Button Text="{Binding Value}" Margin="0" BackgroundColor="{AppThemeBinding Light={StaticResource PdtDayButtonLight}, Dark={StaticResource PdtDayButtonDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource PdtOnSurfaceLight}, Dark={StaticResource PdtOnSurfaceDark}}" FontSize="12" FontFamily="IranianSans"
                                HorizontalOptions="Fill"
                                Command="{Binding BindingContext.SelectMonthCommand,Source={RelativeSource AncestorType={x:Type mpt:Popup}},x:DataType=mpt:Popup}"
                                CommandParameter="{Binding}"/>
                        <!--Command="{Binding Source={x:Reference RootBorder}, Path=BindingContext.SelectMonthCommand}"-->
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- ── Year picker (mode 2) ── -->
            <CollectionView Grid.Column="0" Grid.Row="1" Grid.RowSpan="7" IsVisible="False" ItemsSource="{Binding PersianYears}"
                            ItemSizingStrategy="MeasureFirstItem">
                <CollectionView.Behaviors>
                    <mpt:PlatformColumnSpanBehavior Android="7" iOS="7" WinUI="6"/>
                </CollectionView.Behaviors>
                <CollectionView.Triggers>
                    <DataTrigger TargetType="CollectionView" Binding="{Binding SelectDateMode}" Value="2">
                        <Setter Property="IsVisible" Value="True"/>
                    </DataTrigger>
                </CollectionView.Triggers>
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Span="4" HorizontalItemSpacing="0" Orientation="Vertical"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PuiTuple">
                        <Button Text="{Binding Value}" Margin="0" BackgroundColor="{AppThemeBinding Light={StaticResource PdtDayButtonLight}, Dark={StaticResource PdtDayButtonDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource PdtOnSurfaceLight}, Dark={StaticResource PdtOnSurfaceDark}}" FontSize="15" FontFamily="IranianSans"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type mpt:Popup}}, Path=BindingContext.SelectYearCommand,x:DataType=mpt:Popup}"
                                CommandParameter="{Binding}" Padding="2,10" HorizontalOptions="Fill">
                            <!--Command="{Binding Source={x:Reference RootBorder}, Path=BindingContext.SelectYearCommand}"-->
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding .}" Value="1403">
                                    <Setter Property="TextColor"
                                            Value="{Binding Source={x:Reference RootBorder}, Path=BindingContext.Options.SelectDayColor}"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- ── Days-of-week header (mode 1) ── -->
            <HorizontalStackLayout Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="7" BindableLayout.ItemsSource="{Binding DaysOfWeek}"
                                   HeightRequest="48" IsVisible="False">
                <HorizontalStackLayout.Triggers>
                    <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding SelectDateMode}" Value="1">
                        <Setter Property="IsVisible" Value="True"/>
                    </DataTrigger>
                    <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding Options.CalendarType}" Value="0">
                        <Setter Property="FlowDirection" Value="LeftToRight"/>
                    </DataTrigger>
                </HorizontalStackLayout.Triggers>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label FontSize="11" HorizontalOptions="Center" Text="{Binding}"
                               HeightRequest="36" TextColor="{AppThemeBinding Light={StaticResource PdtOnSurfaceLight}, Dark={StaticResource PdtOnSurfaceDark}}" VerticalOptions="Start"
                               VerticalTextAlignment="Center" WidthRequest="38"
                               HorizontalTextAlignment="Center" FontFamily="IranianSans"/>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>

            <!-- ── Day grid (mode 1) ── -->
            <CollectionView Grid.Column="0" Grid.Row="2" Grid.RowSpan="7" Grid.ColumnSpan="6" ItemsSource="{Binding DaysOfMonth}"
                            IsVisible="False" FlowDirection="RightToLeft" Margin="0" HeightRequest="266" ItemSizingStrategy="MeasureFirstItem">
                <CollectionView.Behaviors>
                    <mpt:PlatformColumnSpanBehavior Android="7" iOS="7" WinUI="6"/>
                </CollectionView.Behaviors>
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Span="7" Orientation="Vertical" HorizontalItemSpacing="0"/>
                </CollectionView.ItemsLayout>
                <CollectionView.Triggers>
                    <DataTrigger TargetType="CollectionView" Binding="{Binding SelectDateMode}" Value="1">
                        <Setter Property="IsVisible" Value="True"/>
                    </DataTrigger>
                    <DataTrigger TargetType="CollectionView" Binding="{Binding Options.CalendarType}" Value="0">
                        <Setter Property="FlowDirection" Value="LeftToRight"/>
                    </DataTrigger>
                </CollectionView.Triggers>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DayOfMonth">
                        <StackLayout IsVisible="{Binding IsInCurrentMonth}">
                            <Button Text="{Binding DayNum}" CommandParameter="{Binding .}" Clicked="BtnDay_Clicked"
                                    FontFamily="IranianSans" CornerRadius="7" Margin="0,2,0,0"
                                    HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="{StaticResource DayButtonSize}"
                                    HeightRequest="{StaticResource DayButtonSize}" Padding="{StaticResource DayButtonPadding}">
                                <Button.Triggers>
                                    <!-- Default/deselected state -->
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PdtOnSurfaceLight}, Dark={StaticResource PdtOnSurfaceDark}}"/>
                                        <!--<Setter Property="Background" Value="White"/>-->
                                    </DataTrigger>

                                    <!-- Disabled day — only the False case needs overriding -->
                                    <DataTrigger TargetType="Button" Binding="{Binding CanSelect}" Value="False">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PdtDisabledLight}, Dark={StaticResource PdtDisabledDark}}"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>

                                    <!-- In-range highlight -->
                                    <DataTrigger TargetType="Button" Binding="{Binding IsInRange, Mode=OneWay}" Value="True">
                                        <Setter Property="BackgroundColor"
                    Value="{Binding Source={x:Reference RootBorder}, Path=BindingContext.Options.InRangeDayColor, Mode=OneWay, FallbackValue='#333'}"/>
                                        <Setter Property="TextColor"
                    Value="{Binding Source={x:Reference RootBorder}, Path=BindingContext.Options.SelectDayColor, Mode=OneWay, FallbackValue='White'}"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsInRange}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PdtDayButtonLight}, Dark={StaticResource PdtDayButtonDark}}"/>
                                    </DataTrigger>

                                    <!-- Holiday -->
                                    <DataTrigger TargetType="Button" Binding="{Binding IsHoliday}" Value="True">
                                        <Setter Property="TextColor" Value="Red"/>
                                    </DataTrigger>

                                    <!-- Selected day -->
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected, Mode=OneWay}" Value="True">
                                        <Setter Property="BackgroundColor"
                    Value="{Binding Source={x:Reference RootBorder}, Path=BindingContext.Options.SelectDayColor, Mode=OneWay, FallbackValue='#333'}"/>
                                        <Setter Property="TextColor" Value="White"/>
                                    </DataTrigger>

                                    <!-- Today border -->
                                    <DataTrigger TargetType="Button" Binding="{Binding IsToday, Mode=OneWay}" Value="True">
                                        <Setter Property="BorderColor"
                    Value="{Binding Source={x:Reference RootBorder}, Path=BindingContext.Options.SelectDayColor, Mode=OneWay, FallbackValue='#333'}"/>
                                        <Setter Property="BorderWidth" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsToday}" Value="False">
                                        <Setter Property="BorderColor" Value="Transparent"/>
                                        <Setter Property="BorderWidth" Value="0"/>
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView Grid.Row="8" HeightRequest="1" Color="{AppThemeBinding Light={StaticResource PdtOutlineLight}, Dark={StaticResource PdtOutlineDark}}" HorizontalOptions="Fill" VerticalOptions="Center">
                <BoxView.Behaviors>
                    <mpt:PlatformColumnSpanBehavior Android="7" iOS="7" WinUI="6"/>
                </BoxView.Behaviors>
            </BoxView>

            <!-- ── Today button ── -->
            <Button Grid.Column="0" Grid.Row="9" Text="{mpt:Localize Today}" Margin="0,0,0,7"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PdtDayButtonLight}, Dark={StaticResource PdtDayButtonDark}}" FontSize="12" Command="{Binding GotoTodayCommand}" FontFamily="IranianSans"
                    TextColor="{Binding Options.SelectDayColor}" BorderColor="{Binding Options.SelectDayColor}" BorderWidth="1">
                <Button.Behaviors>
                    <mpt:PlatformColumnSpanBehavior Android="7" iOS="7" WinUI="6"/>
                </Button.Behaviors>
            </Button>

            <!-- ── Confirm / Cancel buttons (shown when AutoClose is off) ── -->
            <Grid Grid.Column="0" Grid.Row="10" ColumnDefinitions="50*,50*" ColumnSpacing="15"
                  RowSpacing="10" BackgroundColor="{AppThemeBinding Light={StaticResource PdtFooterLight}, Dark={StaticResource PdtFooterDark}}" IsVisible="False" RowDefinitions="Auto">
                <Grid.Behaviors>
                    <mpt:PlatformColumnSpanBehavior Android="7" iOS="7" WinUI="6"/>
                </Grid.Behaviors>
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding Options.AutoCloseAfterSelectDate}" Value="False">
                        <Setter Property="IsVisible" Value="True"/>
                    </DataTrigger>
                </Grid.Triggers>

                <Button Text="{mpt:Localize Cancel}" Grid.Column="1" Grid.Row="0" Margin="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PdtDayButtonLight}, Dark={StaticResource PdtDayButtonDark}}" BorderColor="{AppThemeBinding Light={StaticResource PdtOutlineLight}, Dark={StaticResource PdtOutlineDark}}" FontSize="12"
                        x:Name="btnCancel" FontFamily="IranianSans"
                        TextColor="{Binding Options.SelectDayColor}" BorderWidth="1"/>

                <Button Text="{mpt:Localize Confirm}" Grid.Row="0" Grid.Column="0" Margin="0"
                        BackgroundColor="{Binding Options.SelectDayColor}" FontSize="12"
                        x:Name="btnAccept" FontFamily="IranianSans" TextColor="White"
                        IsEnabled="{Binding CanAccept}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding CanAccept}" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding CanAccept}" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Grid>
    </Border>
</mpt:Popup>
