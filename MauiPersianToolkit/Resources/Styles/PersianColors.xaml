<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Page / chrome -->
    <Color x:Key="PdtPageLight">#F5F5F5</Color>
    <Color x:Key="PdtPageDark">#121212</Color>

    <Color x:Key="PdtSurfaceLight">#FFFFFF</Color>
    <Color x:Key="PdtSurfaceDark">#1E1E1E</Color>

    <Color x:Key="PdtInputFillLight">#FDFDFD</Color>
    <Color x:Key="PdtInputFillDark">#2C2C2C</Color>

    <Color x:Key="PdtOutlineLight">#DCDCDC</Color>
    <Color x:Key="PdtOutlineDark">#555555</Color>

    <Color x:Key="PdtOnSurfaceLight">#121212</Color>
    <Color x:Key="PdtOnSurfaceDark">#F2F2F2</Color>

    <Color x:Key="PdtMutedLight">#666666</Color>
    <Color x:Key="PdtMutedDark">#AAAAAA</Color>

    <Color x:Key="PdtFooterLight">#F5F5F5</Color>
    <Color x:Key="PdtFooterDark">#2A2A2A</Color>

    <Color x:Key="PdtDisabledLight">#999999</Color>
    <Color x:Key="PdtDisabledDark">#777777</Color>

    <Color x:Key="PdtDayButtonLight">#FFFFFF</Color>
    <Color x:Key="PdtDayButtonDark">#2C2C2C</Color>

    <!-- Accents (same in both themes) -->
    <Color x:Key="PdtAccept">#1F883D</Color>
    <Color x:Key="PdtCancel">#FF4500</Color>
    <Color x:Key="PdtAccent">#5B2BDF</Color>

    <!-- Toast / Snackbar: inverted vs page so they stay readable -->
    <Color x:Key="PdtAlertBgLight">#CC323232</Color>
    <Color x:Key="PdtAlertBgDark">#E8E8E8</Color>
    <Color x:Key="PdtAlertFgLight">#FFFFFF</Color>
    <Color x:Key="PdtAlertFgDark">#121212</Color>

</ResourceDictionary>
