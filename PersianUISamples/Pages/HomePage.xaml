<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PersianUISamples.ViewModels"
             xmlns:demo="clr-namespace:PersianUISamples.Controls"
             x:Class="PersianUISamples.Pages.HomePage"
             x:DataType="vm:HomeViewModel"
             x:Name="page"
             Title="{Binding PageTitle}">

    <ScrollView Style="{StaticResource DemoScroll}">
        <VerticalStackLayout Spacing="0">
            <Border StrokeThickness="0" Padding="20" Margin="0,0,0,16"
                    BackgroundColor="{StaticResource PdtAccent}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="MauiPersianToolkit"
                           FontFamily="IranianSans" FontAttributes="Bold" FontSize="24"
                           TextColor="White"/>
                    <Label Text="{Binding VersionLabel}"
                           FontFamily="IranianSans" FontSize="12"
                           TextColor="#E8E4FF"/>
                    <Label Text="{Binding Intro}"
                           FontFamily="IranianSans" FontSize="13"
                           TextColor="White" LineBreakMode="WordWrap" Margin="0,4,0,0"/>
                    <Label Text="{Binding ControlCountText}"
                           FontFamily="IranianSans" FontSize="12"
                           TextColor="#D0C8FF" Margin="0,8,0,0"/>

                    <HorizontalStackLayout Spacing="8" Margin="0,10,0,0">
                        <Border StrokeThickness="0" Padding="10,6" BackgroundColor="#33FFFFFF">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label Text="{Binding ThemeChip}" FontFamily="IranianSans" FontSize="11" TextColor="White"/>
                        </Border>
                        <Border StrokeThickness="0" Padding="10,6" BackgroundColor="#33FFFFFF">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label Text="{Binding LanguageChip}" FontFamily="IranianSans" FontSize="11" TextColor="White"/>
                        </Border>
                        <Border StrokeThickness="0" Padding="10,6" BackgroundColor="#55FFFFFF">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSettingsCommand}"/>
                            </Border.GestureRecognizers>
                            <Label Text="&#xf013;" FontFamily="FontAwesome" FontSize="12" TextColor="White"
                                   HorizontalOptions="Center"/>
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding CategoriesTitle}" Style="{StaticResource DemoPageTitle}" Margin="0,0,0,8"/>
            <Label Text="{Binding CategoriesLead}" Style="{StaticResource DemoPageLead}"/>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Categories}" Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryCard">
                        <Border StrokeThickness="1" Padding="14" Margin="0,0,0,10"
                                Stroke="{AppThemeBinding Light={StaticResource PdtOutlineLight}, Dark={StaticResource PdtOutlineDark}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PdtSurfaceLight}, Dark={StaticResource PdtSurfaceDark}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryTapped"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" WidthRequest="44" HeightRequest="44"
                                        StrokeThickness="0"
                                        BackgroundColor="{StaticResource DemoAccentSoft}"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Icon}" FontFamily="FontAwesome" FontSize="18"
                                           TextColor="{StaticResource PdtAccent}"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Title}" FontFamily="IranianSans" FontAttributes="Bold" FontSize="15"
                                           TextColor="{AppThemeBinding Light={StaticResource PdtOnSurfaceLight}, Dark={StaticResource PdtOnSurfaceDark}}"/>
                                    <Label Text="{Binding Subtitle}" FontFamily="IranianSans" FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource PdtMutedLight}, Dark={StaticResource PdtMutedDark}}"
                                           LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="&#xf053;" FontFamily="FontAwesome" FontSize="14"
                                       TextColor="{StaticResource PdtAccent}"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <demo:DemoSection Title="{Binding HowToTitle}" Hint="{Binding HowToHint}">
                <VerticalStackLayout Spacing="6">
                    <Label FontFamily="IranianSans" FontSize="13" Text="{Binding HowTo1}"
                           TextColor="{AppThemeBinding Light={StaticResource PdtOnSurfaceLight}, Dark={StaticResource PdtOnSurfaceDark}}"/>
                    <Label FontFamily="IranianSans" FontSize="13" Text="{Binding HowTo2}"
                           TextColor="{AppThemeBinding Light={StaticResource PdtOnSurfaceLight}, Dark={StaticResource PdtOnSurfaceDark}}"/>
                    <Label FontFamily="IranianSans" FontSize="13" Text="{Binding HowTo3}"
                           TextColor="{AppThemeBinding Light={StaticResource PdtOnSurfaceLight}, Dark={StaticResource PdtOnSurfaceDark}}"/>
                </VerticalStackLayout>
            </demo:DemoSection>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
